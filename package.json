{
  "name": "hungryhippo",
  "version": "1.1.0",
  "description": "creates feeds where there were none before",
  "license": "EUPL-1.2",
  "author": "Huey <hello@huey.xyz>",
  "main": "dist/app.js",
  "scripts": {
    "babel-node": "babel-node --extensions \".ts\" src/app.ts",
    "build": "babel src -d dist --extensions \".ts\" --copy-files --source-maps",
    "start:dev": "nodemon -e ts --exec npm run babel-node",
    "start:prod": "node dist/app",
    "test": "echo \"No tests\" && exit 0"
  },
  "lint-staged": {
    "*.{ts,d.ts}": [
      "tsc-files --noEmit"
    ],
    "*.{ts,js,json}": [
      "eslint --fix --ignore-pattern"
    ]
  },
  "dependencies": {
    "axios": "^1.7.8",
    "axios-cache-interceptor": "^1.6.2",
    "cheerio": "^1.0.0",
    "dayjs": "^1.11.13",
    "express": "^4.21.1",
    "feed": "^4.2.2",
    "form-data": "^4.0.1",
    "helmet": "^8.0.0",
    "html-entities": "^2.5.2",
    "morgan": "^1.10.0",
    "playwright": "^1.40.0",
    "qs": "^6.13.1"
  },
  "devDependencies": {
    "@babel/cli": "^7.25.9",
    "@babel/core": "^7.26.0",
    "@babel/eslint-plugin": "^7.25.9",
    "@babel/node": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-typescript": "^7.26.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.1",
    "@typescript-eslint/eslint-plugin": "8.16.0",
    "@typescript-eslint/parser": "^8.16.0",
    "dotenv": "^16.4.5",
    "eslint": "9.16.0",
    "eslint-plugin-disable": "^2.0.3",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-json-format": "^2.0.1",
    "eslint-plugin-no-secrets": "^1.1.2",
    "eslint-plugin-node": "11.1.0",
    "eslint-plugin-sonarjs": "^2.0.4",
    "eslint-plugin-sort-keys-fix": "^1.1.2",
    "eslint-plugin-unicorn": "^56.0.1",
    "nodemon": "^3.1.7",
    "tsc-files": "^1.1.4",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=v16.1.0"
  }
}
